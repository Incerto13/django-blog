# Copy to app.env (gitignored). Loaded by both the web and postgres containers.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ENV=production
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django-blog.incertotech.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://django-blog.incertotech.com

POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=change-me
